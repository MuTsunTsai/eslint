{
	"compilerOptions": {
		"rootDir": "../",
		"outDir": "../build",
		"isolatedModules": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"paths": {
			"*": [
				"../src/*"
			]
		},
		"noImplicitOverride": true,
		"preserveSymlinks": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"sourceMap": true,
		"strict": true,
		"target": "esnext",
		"lib": [
			"ESNext"
		],
		"types": [
			"node"
		]
	},
	"include": [
		"./**/*.ts",
	]
}
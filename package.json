{
	"name": "@mutsuntsai/eslint",
	"version": "1.5.2",
	"description": "Customized ESLint config.",
	"keywords": [
		"eslint"
	],
	"sideEffects": false,
	"repository": {
		"type": "git",
		"url": "https://github.com/MuTsunTsai/eslint"
	},
	"license": "MIT",
	"author": "Mu-Tsun Tsai <don.m.t.tsai@gmail.com> (https://github.com/MuTsunTsai)",
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"main": "./dist/index.cjs",
	"types": "./dist/index.d.ts",
	"files": [
		"dist"
	],
	"scripts": {
		"build": "rslib build",
		"dev": "rslib build --watch",
		"lint": "eslint .",
		"lint:inspect": "eslint-config-inspector",
		"test": "rstest"
	},
	"dependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/config-helpers": "^0.7.0",
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@isaacs/brace-expansion": "^5.0.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"@vitest/eslint-plugin": "^1.6.27",
		"eslint-import-resolver-typescript": "^4.4.5",
		"eslint-plugin-html": "^8.2.1",
		"eslint-plugin-import": "^2.32.0",
		"eslint-plugin-mocha": "^12.0.2",
		"eslint-plugin-package-json": "^1.10.1",
		"eslint-plugin-playwright": "^2.12.1",
		"eslint-plugin-vue": "^10.11.1",
		"globals": "^17.13.0",
		"sort-package-json": "^4.0.0",
		"typescript-eslint": "^8.71.1",
		"vue-eslint-parser": "^10.4.1"
	},
	"devDependencies": {
		"@eslint/config-inspector": "^3.5.0",
		"@microsoft/api-extractor": "^7.59.4",
		"@rslib/core": "^1.0.3",
		"@rstest/core": "^0.12.3",
		"@types/chai": "^5.2.3",
		"@types/estree": "^1.0.9",
		"@types/node": "^26.6.4",
		"eslint": "^10.12.0"
	},
	"peerDependencies": {
		"eslint": "^10.0.0"
	}
}
